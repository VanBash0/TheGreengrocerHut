#. Key:	BBD3E65A454075593706D1832692FEDD
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Bones.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Bones.Description
msgctxt ",BBD3E65A454075593706D1832692FEDD"
msgid "Истончение плоти уводит человеческий дух в сторону Нави. Болящий чувствует невесомость и слабость, словно тело его превратилось в сухой камыш, готовый сломаться от ветра."
msgstr ""

#. Key:	BC578FDF4908CD04406D7580D9147BCA
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Bones.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Bones.Name
msgctxt ",BC578FDF4908CD04406D7580D9147BCA"
msgid "Полупрозрачная кожа"
msgstr ""

#. Key:	23609DB043162432ECD7A2B42F357BE6
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Green.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Green.Description
msgctxt ",23609DB043162432ECD7A2B42F357BE6"
msgid "Болотная морока и нутряной хлад проникают в глубину тела. Человека бьёт непрерывная крупная дрожь, из-за которой он не может согреться даже под несколькими тяжелыми кожухами."
msgstr ""

#. Key:	CC552BED4B206312870EAAA80D850AA2
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Green.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Green.Name
msgctxt ",CC552BED4B206312870EAAA80D850AA2"
msgid "Зеленоватый подтон"
msgstr ""

#. Key:	2598B6C34837C2D25E4E7BADEE0BDDA0
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Rash.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Rash.Description
msgctxt ",2598B6C34837C2D25E4E7BADEE0BDDA0"
msgid "Сухой подкожный зуд пробивается мелким зерном.Болящий не может найти покоя ни днём, ни ночью, непрестанно расчёсывая кожу и не спав от мучительного зуда."
msgstr ""

#. Key:	4D826F5D49EC202F64B24FAE714A25A8
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Rash.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Rash.Name
msgctxt ",4D826F5D49EC202F64B24FAE714A25A8"
msgid "Красная сыпь на теле"
msgstr ""

#. Key:	BFC9DA384AADDAC7D22B24B0F7CEC40D
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Red_Smudge.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Red_Smudge.Description
msgctxt ",BFC9DA384AADDAC7D22B24B0F7CEC40D"
msgid "Подкожный жар закипает и выступает багровыми кругами. Человек испытывает сильный нутряной зуд и жжение в груди, неотступно требуя прохладного обдува."
msgstr ""

#. Key:	191552354D7190A599D43CA31BF2A186
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Red_Smudge.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Body_Red_Smudge.Name
msgctxt ",191552354D7190A599D43CA31BF2A186"
msgid "Красные пятна"
msgstr ""

#. Key:	F3CBD3204C200C29A32DEE9C50330714
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Big.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Big.Description
msgctxt ",F3CBD3204C200C29A32DEE9C50330714"
msgid "Заушный нарыв и тяжелый шум закрывают слуховой проход. Болящий испытывает пульсирующую боль в голове, словно внутри уха бьётся и шумит дикий шмель."
msgstr ""

#. Key:	4A4EAB654F6390120F5717818101AD62
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Big.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Big.Name
msgctxt ",4A4EAB654F6390120F5717818101AD62"
msgid "Опухшие уши"
msgstr ""

#. Key:	6C3F6C004A4A18497253DCAD07BFCF5B
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Elf.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Elf.Description
msgctxt ",6C3F6C004A4A18497253DCAD07BFCF5B"
msgid "Лесной зазыв путает мысли и дурманит человеческий слух. Человек слышит несмолкаемый лесной свист и гул, переспрашивает каждое слово и рвется уйти в глухую чащу."
msgstr ""

#. Key:	1F3E38C44AA118E6E06E70BFC4A588D7
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Elf.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Elf.Name
msgctxt ",1F3E38C44AA118E6E06E70BFC4A588D7"
msgid "Заостренные уши"
msgstr ""

#. Key:	78C5232F4F0714B2EBE5D9B2FF9E70A7
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Rash.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Rash.Description
msgctxt ",78C5232F4F0714B2EBE5D9B2FF9E70A7"
msgid "Заушная сушь и растрескивание кожи источают боль. Человек испытывает резкую боль при каждом повороте головы, а прикосновение к одежде вызывает жжение."
msgstr ""

#. Key:	D3DF1AE440FF697BABFFCEB8C642EA56
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Rash.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Rash.Name
msgctxt ",D3DF1AE440FF697BABFFCEB8C642EA56"
msgid "Раздражение за ушами"
msgstr ""

#. Key:	820282CA4BB7D37886D990B8321FD25A
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Red.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Red.Description
msgctxt ",820282CA4BB7D37886D990B8321FD25A"
msgid "Чужой напрасный оглас зажигает ушные раковины. Человеку кажется, будто за его спиной непрерывно шепчутся и бранятся, отчего уши горят как раскаленные угли."
msgstr ""

#. Key:	473CF26D4B45F8D6038C31AC37F0A0C4
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Red.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Ear_Red.Name
msgctxt ",473CF26D4B45F8D6038C31AC37F0A0C4"
msgid "Покрасневшие уши"
msgstr ""

#. Key:	2E4DE7FA461F4E47D289EB945A823F19
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Multicolored.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Multicolored.Description
msgctxt ",2E4DE7FA461F4E47D289EB945A823F19"
msgid "Лесной морок и чужеродная воля туманят взор. Болящий слышит чужие шепоты, смотрит диким, непонимающим взглядом и не узнаёт родных, переступающих порог избы."
msgstr ""

#. Key:	22FFBE5F40BAD1037299FEA2D828B09A
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Multicolored.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Multicolored.Name
msgctxt ",22FFBE5F40BAD1037299FEA2D828B09A"
msgid "Странные глаза"
msgstr ""

#. Key:	DB04A30E4E1B9BC54ED7B6967875DA92
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_red.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_red.Description
msgctxt ",DB04A30E4E1B9BC54ED7B6967875DA92"
msgid "Огненная лихорадка и бессонная мука сушат очесные сосуды. Болящий стенает от рези в очах, будто в глаза сыпанули сухой лесной сажи, и явно не может уснуть уже третью ночь."
msgstr ""

#. Key:	0DABDA7741E69CA71D0C40A8413A4209
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_red.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_red.Name
msgctxt ",0DABDA7741E69CA71D0C40A8413A4209"
msgid "Красные глаза"
msgstr ""

#. Key:	8500235242394C488103BB820EE53063
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_yellow.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_yellow.Description
msgctxt ",8500235242394C488103BB820EE53063"
msgid "Змеиный яд или дурная желчь бродят в нутряных жилах. Человек мучится горечью во рту, нутряным жаром и жалобно просит холодной колодезной воды, не в силах смотреть на свет."
msgstr ""

#. Key:	83CCDE2E4DC637DC613B9F9DA983DFD5
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_yellow.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Sclera_yellow.Name
msgctxt ",83CCDE2E4DC637DC613B9F9DA983DFD5"
msgid "Желчица"
msgstr ""

#. Key:	F9B6F04A4C136CC4C936A782BC61ACFD
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Swelling.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Swelling.Description
msgctxt ",F9B6F04A4C136CC4C936A782BC61ACFD"
msgid "Застоявшаяся водяная тяжесть затворяет человеческий взор. Человек чувствует распирающую тупую боль над бровями, ходит по избе на ощупь и спотыкается о каждую лавку."
msgstr ""

#. Key:	30956952426EDFF8ABA2879EAFA86265
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Swelling.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Eye_Swelling.Name
msgctxt ",30956952426EDFF8ABA2879EAFA86265"
msgid "Опухшие веки"
msgstr ""

#. Key:	FEC2AA0D4F041A8EEE30BFB587A92C9C
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Earthy.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Earthy.Description
msgctxt ",FEC2AA0D4F041A8EEE30BFB587A92C9C"
msgid "Могильная сырость вытягивает из тела природный румянец. Человека одолевает беспросветная тоска, дыхание становится коротким и слабым, а руки становятся холодными, как речной лёд."
msgstr ""

#. Key:	34394E6645FFD9FC80B3989BE8FE8C38
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Earthy.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Earthy.Name
msgctxt ",34394E6645FFD9FC80B3989BE8FE8C38"
msgid "Землистый оттенок лица"
msgstr ""

#. Key:	2556404843DA64E6738914917C30324C
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Red_spots.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Red_spots.Description
msgctxt ",2556404843DA64E6738914917C30324C"
msgid "Подкожный пыл закипает без нутряной лихорадки. Болящий жалуется, будто его щеки непрестанно прижигают горячим углём, хотя температура тела остается обычной."
msgstr ""

#. Key:	132150B04A6CF5DB0D9FE2AFC3F3093C
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Red_spots.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Red_spots.Name
msgctxt ",132150B04A6CF5DB0D9FE2AFC3F3093C"
msgid "Покраснения на лице"
msgstr ""

#. Key:	ABEDDBB7448031E8B8EBE98D49FC1DED
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Sunken.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Sunken.Description
msgctxt ",ABEDDBB7448031E8B8EBE98D49FC1DED"
msgid "Коварный остуд сосёт нутро, оставляя кости да кожу. Болящий жалуется, будто внутри него засел сухой холод. Еда не сытит, а ноги подкашиваются после пары шагов по избе."
msgstr ""

#. Key:	E3AE21DD4504075D583E95883688B9C8
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Sunken.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Sunken.Name
msgctxt ",E3AE21DD4504075D583E95883688B9C8"
msgid "Впалые щёки"
msgstr ""

#. Key:	51E3867A44DCDB9F3A0555936AD27C24
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Veins.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Veins.Description
msgctxt ",51E3867A44DCDB9F3A0555936AD27C24"
msgid "Навья паутина плетется по жилам, охлаждая кровь. Человек чувствует ледяное покалывание в щеках и ломоту в челюсти, словно лицо зажали в железные тиски."
msgstr ""

#. Key:	1C4EDB594675C7C11002D888E9CE97D1
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Veins.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Face_Veins.Name
msgctxt ",1C4EDB594675C7C11002D888E9CE97D1"
msgid "Вены на лице"
msgstr ""

#. Key:	C99C6F6342E03BEC45CE32AF6682E086
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Bold.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Bold.Description
msgctxt ",C99C6F6342E03BEC45CE32AF6682E086"
msgid "От нечистого выстрига, отмирания корня и упадка волосяной силы. Волос у человека вылезает целыми прядями, обнажая бледную, сухую кожу черепа, будто бес ночью ножницами прошёлся. Человек стесняется покрова и прячет голову под плат."
msgstr ""

#. Key:	0A419F5145838C7C9BC29E99C31FE691
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Bold.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Bold.Name
msgctxt ",0A419F5145838C7C9BC29E99C31FE691"
msgid "Плешина"
msgstr ""

#. Key:	186E371D45D3DEE163794CA72F6A1B42
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Dandruff.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Dandruff.Description
msgctxt ",186E371D45D3DEE163794CA72F6A1B42"
msgid "Печная гарь и сухой пожарный морок въедаются в косы. Человек чувствует першение в горле и сухость кожи, а сами косы становятся ломкими, словно высохшая на солнце солома."
msgstr ""

#. Key:	0D6FE4EC48EF7277F6ACAB9D4A498137
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Dandruff.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Dandruff.Name
msgctxt ",0D6FE4EC48EF7277F6ACAB9D4A498137"
msgid "Пепельный налёт"
msgstr ""

#. Key:	7EF22DEF479E64D248DCF59144DED5D2
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Gray.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Gray.Description
msgctxt ",7EF22DEF479E64D248DCF59144DED5D2"
msgid "Нутряной тук закипает и выходит наружу через голову. Болящий ощущает несносный душный жар и туман в голове, из-за чего мысли путаются, а сон становится тревожным."
msgstr ""

#. Key:	99E0CDB545CACAD1C383CFB172BB2DC4
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Gray.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Gray.Name
msgctxt ",99E0CDB545CACAD1C383CFB172BB2DC4"
msgid "Седые корни волос"
msgstr ""

#. Key:	B1D499B54072F44717326F8CE6A2F36B
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Wet.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Wet.Description
msgctxt ",B1D499B54072F44717326F8CE6A2F36B"
msgid "Болотная остуда застревает в прядях и источает хлад. Болящий ощущает тяжесть в затылке и ледяную ломоту в черепе, из-за которой не может согреться даже у растопленной печи."
msgstr ""

#. Key:	AF7119F949AD6384C6E2B48F773F6CD0
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Wet.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hair_Wet.Name
msgctxt ",AF7119F949AD6384C6E2B48F773F6CD0"
msgid "Мокрые волосы"
msgstr ""

#. Key:	DB07BE694F5C39906D569AB7EF343635
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Long_fingers.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Long_fingers.Description
msgctxt ",DB07BE694F5C39906D569AB7EF343635"
msgid "Нечистая навья сила тянет человеческие кости. Человек с ужасом чувствует, как фаланги пальцев теряют силу, становясь неловкими, словно сухие лесные ветви."
msgstr ""

#. Key:	F2BD2AD043C7337D967654B854226D47
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Long_fingers.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Long_fingers.Name
msgctxt ",F2BD2AD043C7337D967654B854226D47"
msgid "Удлиненные пальцы"
msgstr ""

#. Key:	2D637F6B423A011A44B753AA0074B680
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Red_joints.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Red_joints.Description
msgctxt ",2D637F6B423A011A44B753AA0074B680"
msgid "Студёная ломота загоняет воспаление в пальцевые суставы. Болящий не может согнуть пальцы в кулак или удержать ложку — каждое движение отдаётся острой стреляющей болью."
msgstr ""

#. Key:	2FA009F44DDFDE035F93FB900B383514
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Red_joints.Name
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Red_joints.Name
msgctxt ",2FA009F44DDFDE035F93FB900B383514"
msgid "Красные суставы"
msgstr ""

#. Key:	92BAB66A47EF75E458FF7C89654C5AAA
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Wavy_nails.Description
#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Wavy_nails.Description
msgctxt ",92BAB66A47EF75E458FF7C89654C5AAA"
msgid "Смолистое голодание сушит роговую ткань на руках. Пальцы становятся чувствительными к малейшему удару, а сами ногти цепляются за одежду и причиняют мучительную боль."
msgstr ""

#. Key:	5D0C2DE140A7757DF36214A3BF043359
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Hand_Wavy_nails.Name
