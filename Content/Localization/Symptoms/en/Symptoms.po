#: /Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Leg_Red_spots.Description
msgctxt ",E50F399F41AFA995D20394B5014D6E41"
msgid "Кровавый застой пробивается сквозь подкожные жилки. Болящего мучит непрерывное мелкое покалывание в голенях, словно по ногам бегают тысячи лесных муравьев."
msgstr ""

#. Key:	095233564E1215AF20A087A726B7ACCE
#. SourceLocation:	/Game/Data_New/Symptoms/DT_Symptoms.DT_Symptoms.Leg_Red_spots.Name
