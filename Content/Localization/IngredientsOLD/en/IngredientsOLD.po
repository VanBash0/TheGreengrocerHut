#. Key:	CB9230EF4DFBBBF8D8EB09A49077E17B
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Березовый сок.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Березовый сок.Description
msgctxt ",CB9230EF4DFBBBF8D8EB09A49077E17B"
msgid "Прозрачная, чуть сладкая влага, медленно текущая из надреза белой берёзы. Она пахнет весной — талым снегом, светом и молодой корой. В ладони сок кажется живым, словно дерево делится своей тихой силой. Пьёшь его — и будто слышишь, как пробуждается лес."
msgstr ""

#. Key:	1935AAAC4ACC56B55DBC7D89443D7FA5
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Березовый сок.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Березовый сок.DisplayName
msgctxt ",1935AAAC4ACC56B55DBC7D89443D7FA5"
msgid "Березовый сок"
msgstr ""

#. Key:	30918F71400BBC8A70716E983FA113FA
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко.Description
msgctxt ",30918F71400BBC8A70716E983FA113FA"
msgid "Сводит застарелые лишаи и чесотку. Ядовито — лишь крохой.\r\nЦелая ветвь с алой ягодой отдаёт жгучую силу медленно, и слабый отвар годится для долгой кожной хвори. Но яд дремлет в каждой её части — клади самую малость.\r\nЦелые веточки настаивали слабо и обмывали настоем застарелые лишаи."
msgstr ""

#. Key:	F2C8842D4FF7B016473ED99876A1DC12
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко.DisplayName
msgctxt ",F2C8842D4FF7B016473ED99876A1DC12"
msgid "Волчье лыко"
msgstr ""

#. Key:	2427771E407F7F9F79E56B8BC97BCB8A
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Р.Description
msgctxt ",2427771E407F7F9F79E56B8BC97BCB8A"
msgid "Выжигает свежую чесотку и зуд. Ядовито — понемногу.\r\nРезаная кора сразу пускает едкий сок, и отвар берёт кожную заразу, пока она свежа. Но злость его велика — только в малой мере.\r\nРезаной корой, разведя послабее, натирали чесоточные места."
msgstr ""

#. Key:	AD5B56054758EA09EDCAD9B9B28A66A0
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Р.DisplayName
msgctxt ",AD5B56054758EA09EDCAD9B9B28A66A0"
msgid "Ломтики волчьего лыка"
msgstr ""

#. Key:	8EB23B624005AA59F5DF3C86FE87723B
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Т.Description
msgctxt ",8EB23B624005AA59F5DF3C86FE87723B"
msgid "Разом бьёт по кожной язве. Ядовито — лишь щепоть.\r\nСтёртая в порошок кора вспыхивает всей едкостью сразу. Хватит крохотной щепоти, а больше — уже не лекарство, а беда.\r\nСухую ягоду толкли и присыпали лишай крохотной мерой, боясь пересыпать."
msgstr ""

#. Key:	159642DE4125EB41194D8FBEB55D98F4
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.ВолчьеЛыко_Т.DisplayName
msgctxt ",159642DE4125EB41194D8FBEB55D98F4"
msgid "Толчёное волчье лыко"
msgstr ""

#. Key:	972707CB438B70EA33B988B5E71315BC
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика.Description
msgctxt ",972707CB438B70EA33B988B5E71315BC"
msgid "Возвращает силы и румянец выздоравливающим.\r\nЦелые ягоды плавают в отваре и отдают сладкий сок неспешно. Мягкое питьё для тех, кто идёт на поправку, но ещё слаб.\r\nСвежую ягоду ели пригоршнями поднявшимся с постели, чтобы вернуть краску в лицо."
msgstr ""

#. Key:	16007CAA42B86EE6079C53B0431B3F3E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика.DisplayName
msgctxt ",16007CAA42B86EE6079C53B0431B3F3E"
msgid "Голубика"
msgstr ""

#. Key:	DE9C00E84ED7C61ACA1E5492FCA7621E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Р.Description
msgctxt ",DE9C00E84ED7C61ACA1E5492FCA7621E"
msgid "Проясняет усталый, слезящийся взор.\r\nРаздавленная ягода сразу пускает тёмный сок, и отвар освежает глаза и голову — для тех, у кого мутится зрение.\r\nМятую ягоду разводили водой и давали при рези в глазах."
msgstr ""

#. Key:	D5A39B9C4383F96E26D7438D54D93694
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Р.DisplayName
msgctxt ",D5A39B9C4383F96E26D7438D54D93694"
msgid "Рубленая голубика"
msgstr ""

#. Key:	A3D6D5F94FD5AD8B7517D395191C61C3
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Т.Description
msgctxt ",A3D6D5F94FD5AD8B7517D395191C61C3"
msgid "Быстро бодрит и снимает дурноту.\r\nРастёртая в кашицу, она отдаёт всю сладкую силу разом. Короткое питьё, чтобы взбодрить и прогнать слабость.\r\nСушёную ягоду толкли и заваривали крепким взваром для скорого прилива сил."
msgstr ""

#. Key:	7C0D780B401E3BA392DE738BAE618CC7
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Голубика_Т.DisplayName
msgctxt ",7C0D780B401E3BA392DE738BAE618CC7"
msgid "Толчёная голубика"
msgstr ""

#. Key:	BBD6F9E54F6A9C74EFEA3E81E70B46DF
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь.Description
msgctxt ",BBD6F9E54F6A9C74EFEA3E81E70B46DF"
msgid "Укрепляет нутро и вяжет хворь.\r\nТвёрдый плод долго отдаёт вяжущую горечь, и отвар выходит крепкий. Для затяжной внутренней слабости, что не проходит скоро.\r\nЖёлуди вымачивали и клали в долгие отвары «для крепости нутра»."
msgstr ""

#. Key:	CF92CA0545C88DFA010B4AB0D4A1B356
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь.DisplayName
msgctxt ",CF92CA0545C88DFA010B4AB0D4A1B356"
msgid "Желудь"
msgstr ""

#. Key:	F22056844CE29AE7136C928779DED7ED
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Р.Description
msgctxt ",F22056844CE29AE7136C928779DED7ED"
msgid "Унимает понос и резь в животе.\r\nРасколотый жёлудь быстрее отдаёт горькую вязкость, и отвар вяжет расстроенное нутро — когда живот прихватило уже сейчас.\r\nДроблёные жёлуди заливали кипятком и пили при рези в животе."
msgstr ""

#. Key:	A8C07DAD45AB896F65B11EA009DEACFA
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Р.DisplayName
msgctxt ",A8C07DAD45AB896F65B11EA009DEACFA"
msgid "Раскрытый желудь"
msgstr ""

#. Key:	FD9249374D5802DF95A35797F7F0F635
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Т.Description
msgctxt ",FD9249374D5802DF95A35797F7F0F635"
msgid "Сразу останавливает разыгравшееся расстройство.\r\nСтёртый в муку, он расходится в воде вмиг и вяжет разом, коротко и крепко — для внезапной беды с животом.\r\nЖёлудную муку заваривали и давали больному для скорой крепости желудка."
msgstr ""

#. Key:	D60BFB16419A8980CE96B49F6474E970
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Желудь_Т.DisplayName
msgctxt ",D60BFB16419A8980CE96B49F6474E970"
msgid "Толчёный желудь"
msgstr ""

#. Key:	01714A704C1E78D3E8655FA0D48A1DBB
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива.Description
msgctxt ",01714A704C1E78D3E8655FA0D48A1DBB"
msgid "Поднимает обессиленных после долгой болезни.\r\nЦелые стебли отдают силу медленно, и отвар выходит густой, «для крови». Им отпаивают тех, кого хворь оставила без сил надолго.\r\nПучки крапивы запаривали и пили отвар неделями, чтобы встать на ноги после болезни."
msgstr ""

#. Key:	D611FFE34A875B6221FBF999D12FE048
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива.DisplayName
msgctxt ",D611FFE34A875B6221FBF999D12FE048"
msgid "Крапива"
msgstr ""

#. Key:	CC85A7A948C1C38B071A15A85F1BB8A7
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Р.Description
msgctxt ",CC85A7A948C1C38B071A15A85F1BB8A7"
msgid "Разгоняет застой крови и вялость в теле.\r\nРубленая крапива быстро отдаёт жгучий сок, и отвар начинает будоражить кровь — для тех, в ком жизнь еле теплится.\r\nРубленую крапиву клали в похлёбку и квас — «чтобы кровь играла»."
msgstr ""

#. Key:	97838E104AC37B6EEE277897D333DBA2
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Р.DisplayName
msgctxt ",97838E104AC37B6EEE277897D333DBA2"
msgid "Рубленая крапива"
msgstr ""

#. Key:	CCC3F07E46DA41133196E5A01196D60F
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Т.Description
msgctxt ",CCC3F07E46DA41133196E5A01196D60F"
msgid "Взбадривает угасающего — резким толчком.\r\nРастёртая крапива вспыхивает в воде всей жгучестью сразу, коротко и сильно. Когда сил не осталось и нужно встряхнуть тело.\r\nСухую крапиву толкли и подмешивали в питьё совсем ослабевшим."
msgstr ""

#. Key:	FCBDD0604392C20001F7CDBF5851BE87
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Крапива_Т.DisplayName
msgctxt ",FCBDD0604392C20001F7CDBF5851BE87"
msgid "Толчёная крапива"
msgstr ""

#. Key:	A48E74924C56FD5CFCC73FB5B2A85857
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш.Description
msgctxt ",A48E74924C56FD5CFCC73FB5B2A85857"
msgid "Укрепляет слабое, замирающее сердце. Ядовит.\r\nЦелые цветки отдают силу медленно и мягко ведут уставшее сердце ровнее. Но весь цвет пропитан ядом — отмеряй каждый цветок.\r\nЦельные соцветия настаивали и давали понемногу при сердечной немощи."
msgstr ""

#. Key:	6B2598EC4F9B7B5EBC4727B3F0C6706D
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш.DisplayName
msgctxt ",6B2598EC4F9B7B5EBC4727B3F0C6706D"
msgid "Ландыш"
msgstr ""

#. Key:	7D0409924AE389F6E2E46EA29A7B424B
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Р.Description
msgctxt ",7D0409924AE389F6E2E46EA29A7B424B"
msgid "Выравнивает частое, сбитое биение сердца. Ядовит.\r\nИзмельчённый цвет быстрее отдаёт силу, и отвар усмиряет колотящееся сердце — но строго в меру, иначе беда.\r\nРезаные цветки заваривали слабым настоем и поили по счёту глотков."
msgstr ""

#. Key:	6FA58E894C9A1194CDBB0EBD39297BDF
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Р.DisplayName
msgctxt ",6FA58E894C9A1194CDBB0EBD39297BDF"
msgid "Резаный ландыш"
msgstr ""

#. Key:	4AC0004248DFCDED1834BAA370ECFBD5
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Т.Description
msgctxt ",4AC0004248DFCDED1834BAA370ECFBD5"
msgid "Подхлёстывает угасающее сердце разом. Ядовит.\r\nСтёртый в пыль, он отдаёт силу мгновенно, коротким и опасным ударом. Крупица спасает — щепоть губит.\r\nСухие цветки толкли и добавляли крупицами, больше не смея класть."
msgstr ""

#. Key:	E4BFC7834CE5EACA6FF209A531D88AD3
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Ландыш_Т.DisplayName
msgctxt ",E4BFC7834CE5EACA6FF209A531D88AD3"
msgid "Толчёный ландыш"
msgstr ""

#. Key:	28C3228C4840A5E3200DA2A5DD4285B8
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка.Description
msgctxt ",28C3228C4840A5E3200DA2A5DD4285B8"
msgid "Откармливает и ставит на ноги измождённых.\r\nЦелый гриб долго томится и делает отвар сытным и наваристым. Для тех, кого хворь высушила и кому нужно вернуть плоть.\r\nЦельные грибы томили в горшке в печи для наваристого варева больным."
msgstr ""

#. Key:	ECA1B1364A7F5BDFBA2947B27AADD345
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка.DisplayName
msgctxt ",ECA1B1364A7F5BDFBA2947B27AADD345"
msgid "Лисичка"
msgstr ""

#. Key:	E6AE3098421705E8BAF7D1A8CC869241
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Р.Description
msgctxt ",E6AE3098421705E8BAF7D1A8CC869241"
msgid "Прогоняет озноб и внутренний холод после хвори.\r\nНарезанный гриб быстрее отдаёт тепло, и отвар согревает нутро — для того, кого знобит и трясёт.\r\nЛомтики лисичек тушили и давали ослабшим, чтобы согреть."
msgstr ""

#. Key:	B27838424A9DBF05746919BAC405CC55
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Р.DisplayName
msgctxt ",B27838424A9DBF05746919BAC405CC55"
msgid "Рубленая лисичка"
msgstr ""

#. Key:	A79EC67149BF2BECCAAF75B6243562DC
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Т.Description
msgctxt ",A79EC67149BF2BECCAAF75B6243562DC"
msgid "Резко поднимает силы угасающему.\r\nСтёртая в порошок, она отдаёт всю сытную силу сразу — короткий толчок для того, кто совсем плох.\r\nСушёные лисички толкли и подмешивали в питьё тяжелобольным."
msgstr ""

#. Key:	C5E3E8504697AE5B2DABA58AA153B60E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Лисичка_Т.DisplayName
msgctxt ",C5E3E8504697AE5B2DABA58AA153B60E"
msgid "Толчёная лисичка"
msgstr ""

#. Key:	9EA41C3F4E1D9FDCE523FB9C76A5E91B
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь.Description
msgctxt ",9EA41C3F4E1D9FDCE523FB9C76A5E91B"
msgid "Питает и восстанавливает истощённых, детей и стариков.\r\nЦелый корень отдаёт сладкую силу медленно, и отвар выходит мягким, питательным. Для тех, кого хворь довела до худобы.\r\nЦельную морковь запекали в золе и давали выздоравливающим и малым детям."
msgstr ""

#. Key:	ED169D9944A37A0F4015999ED7B0D290
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь.DisplayName
msgctxt ",ED169D9944A37A0F4015999ED7B0D290"
msgid "Морковь"
msgstr ""

#. Key:	AB028D7D49A56B0707F9888D3B41092C
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Р.Description
msgctxt ",AB028D7D49A56B0707F9888D3B41092C"
msgid "Подкрепляет ослабшего, кому нужны силы уже сейчас.\r\nНарезанный корень быстрее отдаёт сок, и отвар питает споро — когда сил нет, а ждать некогда.\r\nЛомтики моркови тушили и кормили ими больных и слабых."
msgstr ""

#. Key:	E56FB27145EE3C6CF984C6B5E41931C1
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Р.DisplayName
msgctxt ",E56FB27145EE3C6CF984C6B5E41931C1"
msgid "Ломтики моркови"
msgstr ""

#. Key:	CDF25EED47B0692BE04F6BB440DFA409
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Т.Description
msgctxt ",CDF25EED47B0692BE04F6BB440DFA409"
msgid "Даёт быстрый сытный толчок совсем обессиленным.\r\nРастёртая в кашицу, она отдаёт всю сладость разом — короткое сытное питьё для того, кто не может есть твёрдого.\r\nТолчёную морковь давали ложками совсем ослабевшим."
msgstr ""

#. Key:	E13329944608870B7E477D9BD91A4BA5
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Морковь_Т.DisplayName
msgctxt ",E13329944608870B7E477D9BD91A4BA5"
msgid "Толчёная морковь"
msgstr ""

#. Key:	0E4AF6774265FDCC60BA99893DA5185E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мочевина.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мочевина.Description
msgctxt ",0E4AF6774265FDCC60BA99893DA5185E"
msgid "Грубая белёсая жидкость с едким, тяжёлым духом, который щекочет нос. Простому человеку он кажется неприятным и резким, но в нём таится странная, суровая сила. Старые зелейники говорят, что бесы чуят этот запах за версту и корчатся от него. Неприметная на вид, она действует как плеть на нечисть, заставляя её бежать прочь."
msgstr ""

#. Key:	A5190CAF46AA308D5FA7B8A0D640234E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мочевина.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мочевина.DisplayName
msgctxt ",A5190CAF46AA308D5FA7B8A0D640234E"
msgid "Мочевина"
msgstr ""

#. Key:	87D88F3E475E7E004FB3E5B31591647D
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор.Description
msgctxt ",87D88F3E475E7E004FB3E5B31591647D"
msgid "Крайнее средство от смертельной хвори. Ядовит насквозь.\r\nЦелая красная шляпка отдаёт свою страшную силу медленно. К ней тянутся, лишь когда надежды уже не осталось — и знают, что она может как спасти, так и убить.\r\nЦельные шляпки настаивали и хранили как последнее средство от тяжких хворей."
msgstr ""

#. Key:	08E45FC74903C3427FB1AA8205DB61B6
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор.DisplayName
msgctxt ",08E45FC74903C3427FB1AA8205DB61B6"
msgid "Мухомор"
msgstr ""

#. Key:	ABE76F114DF8C86CC1D5AFA308252EA1
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Р.Description
msgctxt ",ABE76F114DF8C86CC1D5AFA308252EA1"
msgid "Снимает жестокую ломоту в костях и суставах. Ядовит — понемногу.\r\nНарезанная шляпка быстрее отдаёт яд-лекарство, и отвар глушит нестерпимую боль — но каждый ломоть на строгом счету.\r\nРезаными шляпками растирали ломоту в костях, оберегая рот от зелья."
msgstr ""

#. Key:	A5E51C8E49FCCAF3FBB18298DFEE2EFB
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Р.DisplayName
msgctxt ",A5E51C8E49FCCAF3FBB18298DFEE2EFB"
msgid "Ломтики мухомора"
msgstr ""

#. Key:	AA27C4264B11FB9FD89C7D87C28653F6
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Т.Description
msgctxt ",AA27C4264B11FB9FD89C7D87C28653F6"
msgid "Последний удар, когда всё иное бессильно. Ядовит — лишь щепоть.\r\nСтёртый в пыль, он бьёт всей гибельной силой сразу. Крупица вырывает больного у смерти, щепоть — сводит в могилу.\r\nСухой гриб толкли и добавляли крохой лишь в самом крайнем средстве."
msgstr ""

#. Key:	82574EC74FF70F2C1D82F1A9CB161D71
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Мухомор_Т.DisplayName
msgctxt ",82574EC74FF70F2C1D82F1A9CB161D71"
msgid "Толчёный мухомор"
msgstr ""

#. Key:	B6E0D5184E3AFD52B832569FF9BC3565
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник.Description
msgctxt ",B6E0D5184E3AFD52B832569FF9BC3565"
msgid "Затягивает старые, долго не заживающие раны.\r\nЦелый лист долго лежит в отваре, отдавая тягучий сок понемногу. Годится, когда рану надо заживить надёжно, до самого дна, а не наспех.\r\nСвежий лист привязывали к ране на всю ночь, чтобы к утру она стянулась."
msgstr ""

#. Key:	A43B60AE49B463B860D12CB3A3D3D5C5
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник.DisplayName
msgctxt ",A43B60AE49B463B860D12CB3A3D3D5C5"
msgid "Подорожник"
msgstr ""

#. Key:	2A5A8CF6497F7FA6CE8977A2A8C47290
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Р.Description
msgctxt ",2A5A8CF6497F7FA6CE8977A2A8C47290"
msgid "Вытягивает жар из нарывов и воспалённой кожи.\r\nНадрезанный лист сразу пускает сок, и отвар начинает тянуть гной и красноту наружу — для того, что уже воспалилось и горит.\r\nМятым листом обкладывали нарывы и опухоли, меняя примочку дважды на дню."
msgstr ""

#. Key:	2D25004F487FADA4687910AD5DFA96A5
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Р.DisplayName
msgctxt ",2D25004F487FADA4687910AD5DFA96A5"
msgid "Резаный подорожник"
msgstr ""

#. Key:	D0F4B7214AA8B27D6F1AD495D9E7EA44
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Т.Description
msgctxt ",D0F4B7214AA8B27D6F1AD495D9E7EA44"
msgid "Останавливает свежую кровь из пореза — тут же.\r\nЗелёная кашица расходится в воде вмиг и действует коротко и разом — чтобы унять кровь, пока она бежит.\r\nРастёртый лист прикладывали к порезу прямо в поле, не сходя с места."
msgstr ""

#. Key:	2B544E24490B7C8F879863BEBD65E937
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Подорожник_Т.DisplayName
msgctxt ",2B544E24490B7C8F879863BEBD65E937"
msgid "Подорожная кашица"
msgstr ""

#. Key:	6B2084AB40A8BA34DA5D6DB1E600914F
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Родниковая вода.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Родниковая вода.Description
msgctxt ",6B2084AB40A8BA34DA5D6DB1E600914F"
msgid "Живая основа всякого зелья.\r\nЧистая студёная вода из лесного родника, взятая до восхода. Без неё травам не в чем раскрыть силу.\r\nТакую «живую» воду брали для отваров и заговоров. Наливай её первой."
msgstr ""

#. Key:	86C33C5E4F6E2408934DFD8C81029080
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Родниковая вода.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Родниковая вода.DisplayName
msgctxt ",86C33C5E4F6E2408934DFD8C81029080"
msgid "Родниковая вода"
msgstr ""

#. Key:	BC2943A9439F5C02540FF59489140EE8
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Склянка.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Склянка.Description
msgctxt ",BC2943A9439F5C02540FF59489140EE8"
msgid "Сосуд для готового зелья.\r\nМутноватая склянка с притёртой пробкой. Без неё отвар не унести и не отдать через окошко.\r\nЗелья держали в стекле и глине, чтобы они не выдохлись."
msgstr ""

#. Key:	85C5CC2B4C3629308B808E9C81542404
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Склянка.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Склянка.DisplayName
msgctxt ",85C5CC2B4C3629308B808E9C81542404"
msgid "Склянка"
msgstr ""

#. Key:	390A8CE34127791D7E44278ED76CE48C
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Травяной отвар.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Травяной отвар.Description
msgctxt ",390A8CE34127791D7E44278ED76CE48C"
msgid "Готовое зелье, сваренное по уму.\r\nТёмный душистый отвар, что томился в котле. Если травы правильные — поднимет хворого на ноги.\r\nВ таком деле важен состав, в каком травы шли в котёл."
msgstr ""

#. Key:	28747D6746C71EA90DDF2AB4CE48A50A
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Травяной отвар.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Травяной отвар.DisplayName
msgctxt ",28747D6746C71EA90DDF2AB4CE48A50A"
msgid "Травяной отвар"
msgstr ""

#. Key:	4B93FAAF4133AA03C487F5AF4225A169
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква.Description
msgctxt ",4B93FAAF4133AA03C487F5AF4225A169"
msgid "Унимает жар в животе и тяжесть в нутре — мягко и надолго.\r\nТяжёлый плод отдаёт прохладную мякоть медленно, и отвар выходит студёным, обволакивающим. Для того, у кого нутро горит уже не первый день.\r\nТыкву запекали и кормили мякотью тех, кого мучил внутренний жар."
msgstr ""

#. Key:	345092804D8C5067328549B438EB59EB
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква.DisplayName
msgctxt ",345092804D8C5067328549B438EB59EB"
msgid "Тыква"
msgstr ""

#. Key:	65032DD24357C9AB4F163CAA40A96D66
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Р.Description
msgctxt ",65032DD24357C9AB4F163CAA40A96D66"
msgid "Охлаждает разгорячённое нутро и снимает резь.\r\nНарезанная мякоть быстрее отдаёт прохладный сок, и отвар остужает изнутри — когда жар и резь уже донимают.\r\nЛомти тыквы тушили и давали при жаре и рези в животе."
msgstr ""

#. Key:	6296274D4B10F28C5720F7B976DC78ED
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Р.DisplayName
msgctxt ",6296274D4B10F28C5720F7B976DC78ED"
msgid "Ломтики тыквы"
msgstr ""

#. Key:	6D747AC74D8420489EFB869CCF69D074
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Т.Description
msgctxt ",6D747AC74D8420489EFB869CCF69D074"
msgid "Изгоняет нутряного «червя».\r\nРастёртая мякоть с семенем расходится в воде разом, отдавая всю силу коротко и сразу — для того, что завелось в нутре.\r\nТолчёное тыквенное семя давали натощак — от нутряного червя."
msgstr ""

#. Key:	8AF330434250869126F76C96778120CB
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Тыква_Т.DisplayName
msgctxt ",8AF330434250869126F76C96778120CB"
msgid "Толчёная тыква"
msgstr ""

#. Key:	4FA993F740FACDFC789C01BDFDAB0E7C
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок.Description
msgctxt ",4FA993F740FACDFC789C01BDFDAB0E7C"
msgid "От нутряной простуды и упадка сил, что тянутся давно.\r\nТяжёлая головка тонет на дно и медленно отпускает жгучий дух в воду. Такой отвар греет изнутри и поднимает того, кого хворь измотала не за день.\r\nЦелые головки берегли в связках всю зиму и бросали в горячее питьё, едва в доме кто-то сляжет."
msgstr ""

#. Key:	DF6D614647D3C8AF6D424EAE9863C71E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок.DisplayName
msgctxt ",DF6D614647D3C8AF6D424EAE9863C71E"
msgid "Чеснок"
msgstr ""

#. Key:	CA0CFDD243E1F2C5DE95629727591881
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Р.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Р.Description
msgctxt ",CA0CFDD243E1F2C5DE95629727591881"
msgid "От простуды в горле и груди, что уже дала о себе знать.\r\nРазрезанные дольки сразу пускают в воду острый сок — отвар выходит сильнее и злее, чтобы взять хворь, пока она в разгаре.\r\nРезаным чесноком натирали грудь и дышали над ним, чтобы пробить нос и облегчить кашель."
msgstr ""

#. Key:	AE6DF596423AE79A55AA048A62117FA8
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Р.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Р.DisplayName
msgctxt ",AE6DF596423AE79A55AA048A62117FA8"
msgid "Ломтики чеснока"
msgstr ""

#. Key:	A1303A7A4D0AA5A592BC59899351E7C0
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Т.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Т.Description
msgctxt ",A1303A7A4D0AA5A592BC59899351E7C0"
msgid "Против сглаза и порчи — когда нужно ударить разом.\r\nРастёртая кашица расходится в воде мгновенно, вся её злость вспыхивает сразу. Такой отвар бьёт коротко и сильно — для дурного глаза и внезапной хвори.\r\nТолчёный чеснок клали болящему под изголовье и мазали им пороги — от недоброго."
msgstr ""

#. Key:	A54FCDAE46907F8B5B82BBA91133C706
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Т.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Чеснок_Т.DisplayName
msgctxt ",A54FCDAE46907F8B5B82BBA91133C706"
msgid "Толчёный чеснок"
msgstr ""

#. Key:	8EA233C0494D43ABF225F39BFB71646D
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Шишка.Description
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Шишка.Description
msgctxt ",8EA233C0494D43ABF225F39BFB71646D"
msgid "Заживляет раны смолой — глубоко и надолго.\r\nЦелая шишка отдаёт клейкую смолу медленно, и отвар затягивает раны прочно. Для того, что заживает трудно и долго.\r\nЗелёные шишки настаивали неделями и обмывали настоем незаживающие раны."
msgstr ""

#. Key:	A843205A4987FDD2A083B2BE9D72836E
#. SourceLocation:	/Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Шишка.DisplayName
#: /Game/Data_New/Ingredient/DT_Ingredients.DT_Ingredients.Шишка.DisplayName
msgctxt ",A843205A4987FDD2A083B2BE9D72836E"
msgid "Шишка"
msgstr ""

#. Key:	085090A243E58D7CE6C7ED9AEE3CF830
